#!/usr/bin/env bash
set -euo pipefail

root="$HOME/.local/bin/garmin-sync"
python="$root/venv/bin/python3"
if [[ ! -x "$python" ]]; then
  python="$(command -v python3 || true)"
fi
if [[ -z "$python" || ! -x "$python" ]]; then
  echo "python3 is required" >&2
  exit 69
fi

exec "$python" "$root/garmin_sync.py" "$@"
