[Unit]
Description=GitHub Actions runner for garminSync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/actions-runner-garmin-sync
ExecStart=%h/actions-runner-garmin-sync/run.sh
Restart=always
RestartSec=5
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=default.target
